NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=love_app

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 开发环境未配置短信时使用固定验证码（生产环境必须配置短信）
SMS_DEV_CODE=123456

# 短信（与 Moona 相同通道：AES-128-ECB + 模板变量）
SMS_APP_ID=
SMS_SECRET_KEY=
SMS_BASE_URL=
SMS_TEMPLATE_ID=

# OpenAI 兼容大模型（MiMo、DashScope compatible-mode 等均可用同一套变量）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

AI_TIMEOUT_MS=45000
AI_SYNC_MAX_CONCURRENCY=5
AI_CHAT_FETCH_ATTEMPTS=3

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 对外访问根地址（手机联调填电脑局域网 IP，勿重复带端口）
PUBLIC_HOST=http://127.0.0.1:3000

# 阿里云 OSS（推荐；不配则本地上传 + PUBLIC_HOST/uploads）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
# 可选：自定义 Endpoint，如 https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
# 可选：绑定的 CDN / 自定义域名，如 https://img.yourdomain.com
OSS_CDN_BASE=

# 腾讯云 COS（可选，与 OSS 二选一，一般不用配）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-guangzhou
# COS_CDN_BASE=

# 微信小程序登录（可选）
WX_APPID=
WX_APP_SECRET=

# 微信支付（小程序 JSAPI，商户 API v2 密钥）
WX_MCH_ID=
WX_MCH_API_KEY=
# 支付结果回调，须公网 HTTPS，如 https://api.yourdomain.com/api/vip/wechat/notify
WX_PAY_NOTIFY_URL=

# 广场发帖需审核：true 时新帖 status=2 待审
CONTENT_AUDIT_ENABLED=false

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=